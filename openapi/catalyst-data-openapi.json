{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Connected evidence and measurement platform with public-safe records, institutional workspaces, typed handoffs, governed connectors, reproducible analysis, and platform capability discovery.",
    "title": "Catalyst Data Public API",
    "version": "3.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Healthy"
          }
        },
        "summary": "Repository health"
      }
    },
    "/v1/adapters": {
      "get": {
        "responses": {
          "200": {
            "description": "Adapter manifests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List installed source adapters"
      }
    },
    "/v1/adapters/bindings": {
      "get": {
        "responses": {
          "200": {
            "description": "Bindings"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List source-adapter bindings for the authenticated workspace"
      }
    },
    "/v1/adapters/runs": {
      "get": {
        "responses": {
          "200": {
            "description": "Adapter runs"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List source-adapter runs for the authenticated workspace"
      }
    },
    "/v1/adapters/{connector_id}/run": {
      "post": {
        "responses": {
          "200": {
            "description": "Adapter and connector run result"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Fetch through the bound source adapter and ingest through the connector engine"
      }
    },
    "/v1/archive/items": {
      "get": {
        "responses": {
          "200": {
            "description": "Cached Archive.org items"
          }
        },
        "summary": "Search cached Internet Archive catalog items"
      }
    },
    "/v1/archive/items/{identifier}": {
      "get": {
        "responses": {
          "200": {
            "description": "Cached Archive.org item"
          },
          "404": {
            "description": "Not cached"
          }
        },
        "summary": "Get one cached Archive.org item and file inventory"
      }
    },
    "/v1/archive/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Archive catalog status"
          }
        },
        "summary": "Cached Internet Archive and Wayback catalog status"
      }
    },
    "/v1/capabilities": {
      "get": {
        "responses": {
          "200": {
            "description": "Capabilities"
          }
        },
        "summary": "Capability discovery"
      }
    },
    "/v1/catalog/datasets": {
      "get": {
        "responses": {
          "200": {
            "description": "Dataset catalog search results"
          }
        },
        "summary": "Search the cross-provider Catalyst Data dataset catalog"
      }
    },
    "/v1/catalog/datasets/{catalog_id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Dataset catalog entry"
          },
          "404": {
            "description": "Catalog entry not found"
          }
        },
        "summary": "Get one dataset catalog entry"
      }
    },
    "/v1/catalog/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Dataset catalog status"
          }
        },
        "summary": "Dataset catalog status and freshness counts"
      }
    },
    "/v1/connectors": {
      "get": {
        "responses": {
          "200": {
            "description": "Connector status"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List connectors bound to the authenticated workspace"
      }
    },
    "/v1/connectors/runs": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "connector_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connector runs"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List connector runs for the authenticated workspace"
      }
    },
    "/v1/connectors/{connector_id}/run": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run result"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Run a connector synchronously"
      }
    },
    "/v1/earth/earthquakes": {
      "get": {
        "responses": {
          "200": {
            "description": "USGS earthquake events"
          }
        },
        "summary": "List cached USGS earthquake events"
      }
    },
    "/v1/earth/observations": {
      "get": {
        "responses": {
          "200": {
            "description": "Earth/climate/ocean observations"
          }
        },
        "summary": "List cached NOAA NCEI and ERDDAP observations"
      }
    },
    "/v1/earth/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Environmental data network status"
          }
        },
        "summary": "Cached earth, climate, ocean, IOOS, and earthquake network status"
      }
    },
    "/v1/entities/resolve": {
      "get": {
        "responses": {
          "200": {
            "description": "Entity resolution result"
          }
        },
        "summary": "Resolve a cached canonical entity identifier or name"
      }
    },
    "/v1/entities/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Entity registry status"
          }
        },
        "summary": "Canonical entity registry status"
      }
    },
    "/v1/entities/{entity_id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Canonical entity"
          },
          "404": {
            "description": "Entity not found"
          }
        },
        "summary": "Get one canonical entity with identifiers and aliases"
      }
    },
    "/v1/graph/export": {
      "get": {
        "responses": {
          "200": {
            "description": "Graph export"
          }
        },
        "summary": "Export a bounded JSON-LD-compatible graph"
      }
    },
    "/v1/graph/federate": {
      "get": {
        "responses": {
          "200": {
            "description": "Cross-source federation"
          }
        },
        "summary": "Federate cached observations for a canonical entity"
      }
    },
    "/v1/graph/neighbors": {
      "get": {
        "responses": {
          "200": {
            "description": "Graph neighbors"
          }
        },
        "summary": "Read typed neighbors for a graph node"
      }
    },
    "/v1/graph/nodes": {
      "get": {
        "responses": {
          "200": {
            "description": "Graph node search"
          }
        },
        "summary": "Search connected graph nodes"
      }
    },
    "/v1/graph/nodes/{node_id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Graph node"
          },
          "404": {
            "description": "Node not found"
          }
        },
        "summary": "Get one connected graph node"
      }
    },
    "/v1/graph/path": {
      "get": {
        "responses": {
          "200": {
            "description": "Graph path"
          }
        },
        "summary": "Find a bounded shortest path between graph nodes"
      }
    },
    "/v1/graph/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Graph status"
          }
        },
        "summary": "Connected data graph status"
      }
    },
    "/v1/handoffs": {
      "post": {
        "responses": {
          "202": {
            "description": "Accepted"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Receive a typed platform handoff"
      }
    },
    "/v1/ocean/erddap-datasets": {
      "get": {
        "responses": {
          "200": {
            "description": "ERDDAP datasets"
          }
        },
        "summary": "List cached ERDDAP dataset catalog records"
      }
    },
    "/v1/ocean/ioos-datasets": {
      "get": {
        "responses": {
          "200": {
            "description": "IOOS datasets"
          }
        },
        "summary": "List cached U.S. IOOS Data Catalog records"
      }
    },
    "/v1/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI"
          }
        },
        "summary": "OpenAPI document"
      }
    },
    "/v1/records": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record page"
          }
        },
        "summary": "List externally approved records"
      },
      "post": {
        "responses": {
          "200": {
            "description": "Stored"
          },
          "201": {
            "description": "Created"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create or update a canonical record"
      }
    },
    "/v1/records/{record_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "record_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record"
          },
          "404": {
            "description": "Not found"
          }
        },
        "summary": "Get one externally approved record"
      }
    },
    "/v1/space/close-approaches": {
      "get": {
        "responses": {
          "200": {
            "description": "Close-approach records"
          }
        },
        "summary": "List cached NASA/JPL close approaches"
      }
    },
    "/v1/space/exoplanets": {
      "get": {
        "responses": {
          "200": {
            "description": "Exoplanet records"
          }
        },
        "summary": "List cached NASA Exoplanet Archive records"
      }
    },
    "/v1/space/small-bodies": {
      "get": {
        "responses": {
          "200": {
            "description": "Small-body catalog records"
          }
        },
        "summary": "List cached NASA/JPL SBDB small bodies"
      }
    },
    "/v1/space/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Space/science data network status"
          }
        },
        "summary": "Cached NASA/JPL space and scientific network status"
      }
    },
    "/v1/space/weather-events": {
      "get": {
        "responses": {
          "200": {
            "description": "Space-weather events"
          }
        },
        "summary": "List cached NASA DONKI space-weather events"
      }
    },
    "/v1/statistics/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Global statistics catalog status"
          }
        },
        "summary": "Cached World Bank and UN SDG statistics status"
      }
    },
    "/v1/statistics/un-sdg/observations": {
      "get": {
        "responses": {
          "200": {
            "description": "UN SDG observations"
          }
        },
        "summary": "List cached UN SDG observations"
      }
    },
    "/v1/statistics/world-bank/observations": {
      "get": {
        "responses": {
          "200": {
            "description": "World Bank observations"
          }
        },
        "summary": "List cached World Bank observations"
      }
    },
    "/v1/us-public/epa-records": {
      "get": {
        "responses": {
          "200": {
            "description": "EPA Envirofacts records"
          }
        },
        "summary": "List cached EPA Envirofacts records"
      }
    },
    "/v1/us-public/observations": {
      "get": {
        "responses": {
          "200": {
            "description": "U.S. public-data observations"
          }
        },
        "summary": "List cached normalized Census, BLS, BEA, EIA, and USGS observations"
      }
    },
    "/v1/us-public/status": {
      "get": {
        "responses": {
          "200": {
            "description": "U.S. public-data catalog status"
          }
        },
        "summary": "Cached U.S. public-data status"
      }
    },
    "/v1/wayback/captures": {
      "get": {
        "responses": {
          "200": {
            "description": "Cached Wayback captures"
          }
        },
        "summary": "List cached Wayback captures for a URL"
      }
    },
    "/v1/workspaces": {
      "get": {
        "responses": {
          "200": {
            "description": "Workspace"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List the authenticated client workspace"
      }
    },
    "/v1/workspaces/{workspace_id}/records": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace records"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List authorized workspace records"
      }
    },
    "/v2/platform": {
      "get": {
        "responses": {
          "200": {
            "description": "Platform manifest"
          }
        },
        "summary": "Connected platform manifest"
      }
    },
    "/v2/platform/components": {
      "get": {
        "responses": {
          "200": {
            "description": "Components"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Connected platform components"
      },
      "post": {
        "responses": {
          "200": {
            "description": "Registered"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Register or version a platform component"
      }
    },
    "/v2/platform/readiness": {
      "get": {
        "responses": {
          "200": {
            "description": "Readiness"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Integrated platform readiness"
      }
    },
    "/v2/platform/snapshots": {
      "get": {
        "responses": {
          "200": {
            "description": "Snapshots"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Immutable platform release snapshots"
      },
      "post": {
        "responses": {
          "201": {
            "description": "Snapshot created"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a platform release snapshot"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ]
}
