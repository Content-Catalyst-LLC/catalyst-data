{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Connected evidence and measurement platform with public-safe records, institutional workspaces, typed handoffs, governed connectors, reproducible analysis, and platform capability discovery.",
    "title": "Catalyst Data Public API",
    "version": "2.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Healthy"
          }
        },
        "summary": "Repository health"
      }
    },
    "/v1/adapters": {
      "get": {
        "responses": {
          "200": {
            "description": "Adapter manifests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List installed source adapters"
      }
    },
    "/v1/adapters/bindings": {
      "get": {
        "responses": {
          "200": {
            "description": "Bindings"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List source-adapter bindings for the authenticated workspace"
      }
    },
    "/v1/adapters/runs": {
      "get": {
        "responses": {
          "200": {
            "description": "Adapter runs"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List source-adapter runs for the authenticated workspace"
      }
    },
    "/v1/adapters/{connector_id}/run": {
      "post": {
        "responses": {
          "200": {
            "description": "Adapter and connector run result"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Fetch through the bound source adapter and ingest through the connector engine"
      }
    },
    "/v1/capabilities": {
      "get": {
        "responses": {
          "200": {
            "description": "Capabilities"
          }
        },
        "summary": "Capability discovery"
      }
    },
    "/v1/connectors": {
      "get": {
        "responses": {
          "200": {
            "description": "Connector status"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List connectors bound to the authenticated workspace"
      }
    },
    "/v1/connectors/runs": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "connector_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connector runs"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List connector runs for the authenticated workspace"
      }
    },
    "/v1/connectors/{connector_id}/run": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run result"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Run a connector synchronously"
      }
    },
    "/v1/handoffs": {
      "post": {
        "responses": {
          "202": {
            "description": "Accepted"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Receive a typed platform handoff"
      }
    },
    "/v1/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI"
          }
        },
        "summary": "OpenAPI document"
      }
    },
    "/v1/records": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record page"
          }
        },
        "summary": "List externally approved records"
      },
      "post": {
        "responses": {
          "200": {
            "description": "Stored"
          },
          "201": {
            "description": "Created"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create or update a canonical record"
      }
    },
    "/v1/records/{record_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "record_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record"
          },
          "404": {
            "description": "Not found"
          }
        },
        "summary": "Get one externally approved record"
      }
    },
    "/v1/workspaces": {
      "get": {
        "responses": {
          "200": {
            "description": "Workspace"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List the authenticated client workspace"
      }
    },
    "/v1/workspaces/{workspace_id}/records": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace records"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List authorized workspace records"
      }
    },
    "/v2/platform": {
      "get": {
        "responses": {
          "200": {
            "description": "Platform manifest"
          }
        },
        "summary": "Connected platform manifest"
      }
    },
    "/v2/platform/components": {
      "get": {
        "responses": {
          "200": {
            "description": "Components"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Connected platform components"
      },
      "post": {
        "responses": {
          "200": {
            "description": "Registered"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Register or version a platform component"
      }
    },
    "/v2/platform/readiness": {
      "get": {
        "responses": {
          "200": {
            "description": "Readiness"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Integrated platform readiness"
      }
    },
    "/v2/platform/snapshots": {
      "get": {
        "responses": {
          "200": {
            "description": "Snapshots"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Immutable platform release snapshots"
      },
      "post": {
        "responses": {
          "201": {
            "description": "Snapshot created"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a platform release snapshot"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ]
}
